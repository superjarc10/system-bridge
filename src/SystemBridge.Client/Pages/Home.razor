@page "/"
@inject ApiClient Api
@inject LocalizationService L
@implements IDisposable

<PageTitle>SystemBridge @L["Management"]</PageTitle>

@if (!Api.IsAuthenticated)
{
    <section class="panel login-panel login-card">
        <div class="panel-heading"><span class="panel-kicker">@L["Access"]</span><h2>@L["SignInToContinue"]</h2></div>
        <div class="form-grid"><label>@L["Username"] <input @bind="login.Username" /></label><label>@L["Password"] <input type="password" @bind="login.Password" /></label></div>
        <button class="primary" @onclick="LoginAsync">@L["SignIn"]</button>
        @if (!string.IsNullOrWhiteSpace(message)) { <p class="message">@message</p> }
    </section>
}
else
{
    <div class="management-layout">
        <nav class="resource-rail" aria-label="Management resources">
            <p class="rail-label">@L["Workspaces"]</p>
            @foreach (var resource in resources)
            {
                <button class="rail-button @(activeResource == resource ? "rail-active" : "")" @onclick="() => SelectResource(resource)">
                    <span class="rail-index">@ResourceIndex(resource)</span>@L[resource]
                </button>
            }
        </nav>

        <main class="management-content">
            @if (activeResource == "Customers")
            {
                <ResourcePanel Title="Customers" Count="customers.Count" OnRefresh="LoadCustomersAsync">
                    <div class="panel-toolbar"><span>@L["CustomersSub"]</span><button class="primary" @onclick="OpenCustomerForm">@L["AddCustomer"]</button></div>
                    @if (showCustomerForm) { <div class="entry-form"><div class="form-grid"><label>@L["Name"] <input @bind="customerForm.Name" /></label><label>@L["Country"] <input @bind="customerForm.Country" /></label></div><FormActions OnSave="SaveCustomerAsync" OnCancel="CancelForms" Label="@(customerId.HasValue ? L["UpdateCustomer"] : L["CreateCustomer"])" /></div> }
                    <EntityTable>@foreach (var item in customers) { <tr><td><strong>@item.Name</strong><small>@item.Country</small></td><td class="actions"><button class="link-button" @onclick="() => EditCustomer(item)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeleteCustomerAsync(item.Id)">@L["Delete"]</button></td></tr> }</EntityTable>
                </ResourcePanel>
            }
            else if (activeResource == "Products")
            {
                <div class="nested-switch"><button class="@(productView == "Products" ? "nested-active" : "")" @onclick="ShowProducts">@L["Products"]</button><button class="@(productView == "Packaging" ? "nested-active" : "")" @onclick="ShowPackaging">@L["Packaging"]</button></div>
                @if (productView == "Products")
                {
                    <ResourcePanel Title="Products" Count="products.Count" OnRefresh="LoadProductsAsync">
                        <div class="panel-toolbar"><span>@L["ProductsSub"]</span><button class="primary" @onclick="OpenProductForm">@L["AddProduct"]</button></div>
                        @if (showProductForm) { <div class="entry-form"><div class="form-grid"><label>@L["Name"] <input @bind="productForm.Name" /></label><label>@L["Description"] <input @bind="productForm.Description" /></label><label>@L["PricePer1000"] <input type="number" @bind="productForm.PricePer1000" /></label><label>@L["CapacityPerHour"] <input type="number" @bind="productForm.ManufacturingCapacityPerHour" /></label><label>@L["WeightPer1000"] <input type="number" @bind="productForm.WeightPer1000" /></label></div><FormActions OnSave="SaveProductAsync" OnCancel="CancelForms" Label="@(productId.HasValue ? L["UpdateProduct"] : L["CreateProduct"])" /></div> }
                        <EntityTable>
                            @foreach (var item in products)
                            {
                                <tr><td><button class="disclosure-button" @onclick="() => ToggleProductDetails(item.Id)">@(expandedProductId == item.Id ? "▾" : "▸")</button><strong>@item.Name</strong><small>@item.Description</small></td><td>@item.PricePer1000?.ToString("C")</td><td class="actions"><button class="link-button" @onclick="() => EditProduct(item)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeleteProductAsync(item.Id)">@L["Delete"]</button></td></tr>
                                @if (expandedProductId == item.Id)
                                {
                                    <tr class="detail-row"><td colspan="3"><div class="detail-grid"><span><small>@L["CapacityPerHour"]</small>@item.ManufacturingCapacityPerHour.ToString("N0")</span><span><small>@L["WeightPer1000"]</small>@item.WeightPer1000.ToString("N0")</span><span><small>@L["PackagingOptions"]</small>@packaging.Count(x => x.ProductId == item.Id).ToString("N0")</span></div></td></tr>
                                }
                            }
                        </EntityTable>
                    </ResourcePanel>
                }
                else
                {
                    <ResourcePanel Title="ProductPackaging" Count="packaging.Count" OnRefresh="LoadPackagingAsync">
                        <div class="panel-toolbar"><span>@L["PackagingSub"]</span><button class="primary" @onclick="OpenPackagingForm">@L["AddPackaging"]</button></div>
                        @if (showPackagingForm) { <div class="entry-form"><div class="form-grid"><label>@L["Products"] <select @bind="packagingForm.ProductId">@foreach (var item in products) { <option value="@item.Id">@item.Name</option> }</select></label><label>@L["Type"] <select @bind="packagingForm.PackagingTypeId"><option value="">@L["SelectType"]</option>@foreach (var type in packagingTypes) { <option value="@type.Id">@type.Name</option> }</select></label><label>@L["Pieces"] <input type="number" @bind="packagingForm.Pieces" /></label></div><FormActions OnSave="SavePackagingAsync" OnCancel="CancelForms" Label="@(packagingId.HasValue ? L["UpdatePackaging"] : L["CreatePackaging"])" /></div> }
                        <EntityTable>
                            @foreach (var item in packaging)
                            {
                                <tr><td><button class="disclosure-button" @onclick="() => TogglePackagingDetails(item.Id)">@(expandedPackagingId == item.Id ? "▾" : "▸")</button><strong>@ProductName(item.ProductId)</strong><small>@item.Type</small></td><td>@item.Pieces.ToString("N0") @L["Pieces"]</td><td class="actions"><button class="link-button" @onclick="() => EditPackaging(item)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeletePackagingAsync(item.Id)">@L["Delete"]</button></td></tr>
                                @if (expandedPackagingId == item.Id)
                                {
                                    <tr class="detail-row"><td colspan="3"><div class="detail-grid"><span><small>@L["Products"]</small>@ProductName(item.ProductId)</span><span><small>@L["PackagingTypes"]</small>@item.Type</span><span><small>@L["PiecesPerPackage"]</small>@item.Pieces.ToString("N0")</span></div></td></tr>
                                }
                            }
                        </EntityTable>
                    </ResourcePanel>
                }
                @if (productView == "Packaging")
                {
                    <ResourcePanel Title="PackagingTypes" Count="packagingTypes.Count" OnRefresh="LoadPackagingTypesAsync">
                        <div class="panel-toolbar"><span>@L["PackagingTypesSub"]</span><button class="primary" @onclick="OpenPackagingTypeForm">@L["AddType"]</button></div>
                        @if (showPackagingTypeForm) { <div class="entry-form"><div class="form-grid"><label>@L["Name"] <input @bind="packagingTypeForm.Name" /></label></div><FormActions OnSave="SavePackagingTypeAsync" OnCancel="CancelForms" Label="@(packagingTypeId.HasValue ? L["UpdateType"] : L["CreateType"])" /></div> }
                        <EntityTable>@foreach (var type in packagingTypes) { <tr><td><strong>@type.Name</strong></td><td class="actions"><button class="link-button" @onclick="() => EditPackagingType(type)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeletePackagingTypeAsync(type.Id)">@L["Delete"]</button></td></tr> }</EntityTable>
                    </ResourcePanel>
                }
            }
            else if (activeResource == "Orders")
            {
                <ResourcePanel Title="Orders" Count="orders.Count" OnRefresh="LoadOrdersAsync">
                    <div class="panel-toolbar"><span>@L["OrdersSub"]</span><div class="sort-controls"><label>@L["Sort"] <select @bind="orderSort"><option value="Date">@L["Date"]</option><option value="Alphabet">@L["Alphabet"]</option><option value="Status">@L["Status"]</option></select></label><button class="secondary direction-button" @onclick="ToggleOrderSortDirection" title="Toggle sort direction">@(orderSortAscending ? "↑" : "↓")</button><button class="primary" @onclick="OpenOrderForm">@L["AddOrder"]</button></div></div>
                    @if (showOrderForm) { <div class="entry-form"><div class="form-grid"><label>@L["OrderNumber"] <input @bind="orderForm.OrderNumber" placeholder="ORD-2026-001" /></label><label>@L["Customers"] <select @bind="orderForm.CustomerId">@foreach (var item in customers) { <option value="@item.Id">@item.Name</option> }</select></label><label>@L["OrderDate"] <input type="date" @bind-value="orderForm.ScheduledDate" @bind-value:format="yyyy-MM-dd" /></label><label>@L["Status"] <select @bind="orderForm.Status">@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status">@L[status.ToString()]</option> }</select></label><label>@L["Notes"] <input @bind="orderForm.Notes" /></label></div><FormActions OnSave="SaveOrderAsync" OnCancel="CancelForms" Label="@(orderId.HasValue ? L["UpdateOrder"] : L["CreateOrder"])" /></div> }
                    <EntityTable>
                        @foreach (var item in SortedOrders)
                        {
                            <tr style="border-left: 5px solid @item.Color"><td><button class="disclosure-button" @onclick="() => ToggleOrderItems(item.Id)">@(expandedOrderId == item.Id ? "▾" : "▸")</button><strong class="customer-label">@CustomerName(item.CustomerId)</strong><strong class="date-label">@(item.ScheduledDate?.ToLocalTime().ToString("d") ?? L["NoDate"])</strong><small class="order-number-label">@(string.IsNullOrWhiteSpace(item.OrderNumber) ? $"{L["Orders"]} #{item.Id}" : item.OrderNumber)</small></td><td><span class="status-badge">@L[item.Status.ToString()]</span></td><td class="actions"><button class="link-button" @onclick="() => EditOrder(item)">@L["Edit"]</button><button class="link-button" @onclick="() => ToggleOrderHistory(item.Id)">@L["History"]</button><button class="danger-button" @onclick="() => DeleteOrderAsync(item.Id)">@L["Delete"]</button></td></tr>
                            @if (expandedOrderId == item.Id)
                            {
                                <tr class="child-row"><td colspan="3">@if (orderHistoryOrderId == item.Id) { <ChangeHistoryPanel Entries="orderHistory" OnClear="() => ClearOrderHistoryAsync(item.Id)" /> }<div class="child-heading"><strong>@L["OrderItems"]</strong><button class="secondary" @onclick="() => OpenOrderItemForm(item.Id)">@L["AddOrderItem"]</button></div>@if (showOrderItemForm && orderItemForm.OrderId == item.Id) { <div class="entry-form"><div class="form-grid"><label>@L["Products"] <select @bind="orderItemForm.ProductId">@foreach (var product in products) { <option value="@product.Id">@product.Name</option> }</select></label><label>@L["Quantity"] <input type="number" @bind="orderItemForm.Quantity" /></label></div><FormActions OnSave="SaveOrderItemAsync" OnCancel="CancelForms" Label="@(orderItemId.HasValue ? L["UpdateItem"] : L["AddItem"])" /></div> }<EntityTable>@foreach (var child in orderItems.Where(x => x.OrderId == item.Id)) { <tr><td><strong>@ProductName(child.ProductId)</strong></td><td>@child.Quantity.ToString("N0") @L["Units"]</td><td class="actions"><button class="link-button" @onclick="() => EditOrderItem(child)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeleteOrderItemAsync(child.Id)">@L["Delete"]</button></td></tr> }</EntityTable></td></tr>
                            }
                        }
                    </EntityTable>
                </ResourcePanel>
            }
            else if (activeResource == "Shipments")
            {
                <ResourcePanel Title="Shipments" Count="shipments.Count" OnRefresh="LoadShipmentsAsync">
                    <div class="panel-toolbar"><span>@L["ShipmentsSub"]</span><div class="sort-controls"><label>@L["Sort"] <select @bind="shipmentSort"><option value="Date">@L["Date"]</option><option value="Alphabet">@L["Alphabet"]</option><option value="Status">@L["Status"]</option></select></label><button class="secondary direction-button" @onclick="ToggleShipmentSortDirection" title="Toggle sort direction">@(shipmentSortAscending ? "↑" : "↓")</button><button class="primary" @onclick="OpenShipmentForm">@L["AddShipment"]</button></div></div>
                    @if (showShipmentForm) { <div class="entry-form"><div class="form-grid"><label>@L["ShipmentNumber"] <input @bind="shipmentForm.ShipmentNumber" placeholder="SHP-20260825-001" /></label><label>@L["Customers"] <select @bind="shipmentForm.CustomerId">@foreach (var item in customers) { <option value="@item.Id">@item.Name</option> }</select></label><label>@L["Type"] <select @bind="shipmentForm.Type">@foreach (var type in Enum.GetValues<ShipmentType>()) { <option value="@type">@L[type.ToString()]</option> }</select></label><label>@L["ShipmentDate"] <input type="date" @bind-value="shipmentForm.ScheduledDate" @bind-value:format="yyyy-MM-dd" /></label><label>@L["Status"] <select @bind="shipmentForm.Status">@foreach (var status in Enum.GetValues<ShipmentStatus>()) { <option value="@status">@L[status.ToString()]</option> }</select></label><label class="toggle-field"><input type="checkbox" @bind="shipmentForm.TruckDeliveryConfirmed" /> @L["TruckDeliveryConfirmed"]</label></div><FormActions OnSave="SaveShipmentAsync" OnCancel="CancelForms" Label="@(shipmentId.HasValue ? L["UpdateShipment"] : L["CreateShipment"])" /></div> }
                    <EntityTable>
                        @foreach (var item in SortedShipments)
                        {
                            <tr style="border-left: 5px solid @item.Color"><td><button class="disclosure-button" @onclick="() => ToggleShipmentItems(item.Id)">@(expandedShipmentId == item.Id ? "▾" : "▸")</button><strong class="customer-label">@CustomerName(item.CustomerId)</strong><strong class="date-label">@(item.ScheduledDate?.ToLocalTime().ToString("d") ?? L["NoDate"])</strong><small class="shipment-number-label">@(string.IsNullOrWhiteSpace(item.ShipmentNumber) ? $"{L["Shipments"]} #{item.Id}" : item.ShipmentNumber)</small></td><td><span class="type-badge @(item.Type == ShipmentType.IN ? "type-in" : "type-out")">@L[item.Type.ToString()]</span><span class="status-badge">@L[item.Status.ToString()]</span><span class="truck-status @(item.TruckDeliveryConfirmed ? "truck-confirmed" : "truck-pending")">@(item.TruckDeliveryConfirmed ? L["TruckConfirmed"] : L["TruckPending"])</span></td><td class="actions"><button class="link-button" @onclick="() => EditShipment(item)">@L["Edit"]</button><button class="link-button" @onclick="() => ToggleShipmentHistory(item.Id)">@L["History"]</button><button class="danger-button" @onclick="() => DeleteShipmentAsync(item.Id)">@L["Delete"]</button></td></tr>
                            @if (expandedShipmentId == item.Id)
                            {
                                <tr class="child-row"><td colspan="3">@if (shipmentHistoryShipmentId == item.Id) { <ChangeHistoryPanel Entries="shipmentHistory" OnClear="() => ClearShipmentHistoryAsync(item.Id)" /> }<ShipmentStats ShipmentId="item.Id" ShipmentItems="shipmentItems" OrderItems="orderItems" Packaging="packaging" Products="products" Pallets="pallets" Orders="orders" Customers="customers" OnEdit="EditShipmentItem" OnDelete="DeleteShipmentItemAsync" /><div class="child-heading"><strong>@L["ShipmentItems"]</strong><button class="secondary" @onclick="() => OpenShipmentItemForm(item.Id)">@L["AddShipmentItem"]</button></div>@if (showShipmentItemForm && shipmentItemForm.ShipmentId == item.Id) { <div class="entry-form"><div class="form-grid"><label>@L["Orders"] <select @bind="shipmentItemOrderId" @bind:after="SyncShipmentOrderSelection">@foreach (var order in orders) { <option value="@order.Id">@CustomerName(order.CustomerId) - @(order.ScheduledDate?.ToLocalTime().ToString("d") ?? L["NoDate"])</option> }</select></label><label>@L["OrderItems"] <select @bind="shipmentItemForm.OrderItemId">@foreach (var orderItem in ShipmentOrderItems) { <option value="@orderItem.Id">@ProductName(orderItem.ProductId) - @orderItem.Quantity.ToString("N0") @L["Units"]</option> }</select></label><label>@L["Packaging"] <select @bind="shipmentItemForm.ProductPackagingId">@foreach (var package in packaging) { <option value="@package.Id">@ProductName(package.ProductId)</option> }</select></label><label>@L["Pallets"] <select @bind="shipmentItemForm.PalletId"><option value="">@L["WithoutPallet"]</option>@foreach (var pallet in pallets) { <option value="@pallet.Id">@pallet.Name (@pallet.Quantity.ToString("N0") @L["Packages"])</option> }</select></label><label>@(shipmentItemForm.PalletId.HasValue ? L["PalletCount"] : L["PackagingCount"]) <input type="number" @bind="shipmentItemForm.Quantity" /></label></div><FormActions OnSave="SaveShipmentItemAsync" OnCancel="CancelForms" Label="@(shipmentItemId.HasValue ? L["UpdateItem"] : L["AddItem"])" /></div> }</td></tr>
                            }
                        }
                    </EntityTable>
                </ResourcePanel>
            }
            else
            {
                <ResourcePanel Title="Pallets" Count="pallets.Count" OnRefresh="LoadPalletsAsync">
                    <div class="panel-toolbar"><span>@L["PalletsSub"]</span><button class="primary" @onclick="OpenPalletForm">@L["AddPallet"]</button></div>
                    @if (showPalletForm) { <div class="entry-form"><div class="form-grid"><label>@L["Name"] <input @bind="palletForm.Name" /></label><label>@L["Description"] <input @bind="palletForm.Description" /></label><label>@L["Quantity"] <input type="number" @bind="palletForm.Quantity" /></label></div><FormActions OnSave="SavePalletAsync" OnCancel="CancelForms" Label="@(palletId.HasValue ? L["UpdatePallet"] : L["CreatePallet"])" /></div> }
                    <EntityTable>@foreach (var item in pallets) { <tr><td><strong>@item.Name</strong><small>@item.Description</small></td><td>@item.Quantity.ToString("N0") @L["Units"]</td><td class="actions"><button class="link-button" @onclick="() => EditPallet(item)">@L["Edit"]</button><button class="danger-button" @onclick="() => DeletePalletAsync(item.Id)">@L["Delete"]</button></td></tr> }</EntityTable>
                </ResourcePanel>
            }
        </main>
    </div>
}

@code {
    private readonly string[] resources = ["Customers", "Products", "Orders", "Shipments", "Pallets"];
    private string activeResource = "Customers"; private string productView = "Products"; private string orderSort = "Date"; private bool orderSortAscending = false; private string shipmentSort = "Date"; private bool shipmentSortAscending = false;
    private readonly LoginRequest login = new() { Username = "admin", Password = "password" }; private string message = string.Empty;
    private List<Customer> customers = []; private List<Product> products = []; private List<ProductPackaging> packaging = []; private List<PackagingType> packagingTypes = []; private List<Pallet> pallets = []; private List<Order> orders = []; private List<OrderItem> orderItems = []; private List<Shipment> shipments = []; private List<ShipmentItem> shipmentItems = []; private List<ChangeHistory> orderHistory = []; private List<ChangeHistory> shipmentHistory = []; private int? orderHistoryOrderId; private int? shipmentHistoryShipmentId; private int? expandedProductId; private int? expandedPackagingId; private int? expandedOrderId; private int? expandedShipmentId;
    private CustomerRequest customerForm = new(); private int? customerId; private bool showCustomerForm; private ProductRequest productForm = new(); private int? productId; private bool showProductForm; private ProductPackagingRequest packagingForm = new(); private int? packagingId; private bool showPackagingForm; private PackagingTypeRequest packagingTypeForm = new(); private int? packagingTypeId; private bool showPackagingTypeForm; private PalletRequest palletForm = new(); private int? palletId; private bool showPalletForm; private OrderRequest orderForm = new(); private int? orderId; private bool showOrderForm; private OrderItemRequest orderItemForm = new(); private int? orderItemId; private bool showOrderItemForm; private ShipmentRequest shipmentForm = new(); private int? shipmentId; private bool showShipmentForm; private ShipmentItemRequest shipmentItemForm = new(); private int? shipmentItemId; private bool showShipmentItemForm; private int shipmentItemOrderId;

    protected override async Task OnInitializedAsync()
    {
        L.OnLanguageChanged += OnLanguageChanged;
        if (Api.IsAuthenticated) await LoadAllAsync();
    }
    private void OnLanguageChanged() => StateHasChanged();
    public void Dispose() => L.OnLanguageChanged -= OnLanguageChanged;
    private async Task LoginAsync() { try { var response = await Api.LoginAsync(login); message = response is null ? "Invalid username or password." : string.Empty; if (response is not null) await LoadAllAsync(); } catch (HttpRequestException) { message = "The API is unavailable. Start the backend and try again."; } }
    private async Task LoadAllAsync() { customers = await Api.GetCustomersAsync(); products = await Api.GetProductsAsync(); packaging = await Api.GetProductPackagingAsync(); packagingTypes = await Api.GetPackagingTypesAsync(); pallets = await Api.GetPalletsAsync(); orders = await Api.GetOrdersAsync(); orderItems = await Api.GetOrderItemsAsync(); shipments = await Api.GetShipmentsAsync(); shipmentItems = await Api.GetShipmentItemsAsync(); }
    private void SelectResource(string resource) { activeResource = resource; CancelForms(); }
    private void ShowProducts() { productView = "Products"; CancelForms(); }
    private void ShowPackaging() { productView = "Packaging"; CancelForms(); }
    private void CancelForms() { showCustomerForm = showProductForm = showPackagingForm = showPackagingTypeForm = showPalletForm = showOrderForm = showOrderItemForm = showShipmentForm = showShipmentItemForm = false; customerId = productId = packagingId = packagingTypeId = palletId = orderId = orderItemId = shipmentId = shipmentItemId = null; }
    private string ResourceIndex(string resource) => resource switch { "Customers" => "01", "Products" => "02", "Orders" => "03", "Shipments" => "04", _ => "05" };
    private void OpenCustomerForm() { CancelForms(); showCustomerForm = true; customerForm = new(); } private void OpenProductForm() { CancelForms(); showProductForm = true; productForm = new(); } private void OpenPackagingForm() { CancelForms(); showPackagingForm = true; packagingForm = new() { ProductId = products.FirstOrDefault()?.Id ?? 0, PackagingTypeId = packagingTypes.FirstOrDefault()?.Id }; } private void OpenPackagingTypeForm() { CancelForms(); showPackagingTypeForm = true; packagingTypeForm = new(); } private void OpenPalletForm() { CancelForms(); showPalletForm = true; palletForm = new(); } private void OpenOrderForm() { CancelForms(); showOrderForm = true; orderForm = new() { OrderNumber = NewOrderNumber(), CustomerId = customers.FirstOrDefault()?.Id ?? 0, ScheduledDate = DateTime.Today }; } private void OpenOrderItemForm(int orderId) { CancelForms(); expandedOrderId = orderId; showOrderItemForm = true; orderItemForm = new() { OrderId = orderId, ProductId = products.FirstOrDefault()?.Id ?? 0, Quantity = 1 }; } private void OpenShipmentForm() { CancelForms(); showShipmentForm = true; shipmentForm = new() { ShipmentNumber = NewShipmentNumber(), CustomerId = customers.FirstOrDefault()?.Id ?? 0, ScheduledDate = DateTime.Today }; } private void OpenShipmentItemForm(int shipmentId) { CancelForms(); expandedShipmentId = shipmentId; showShipmentItemForm = true; shipmentItemOrderId = orderItems.FirstOrDefault()?.OrderId ?? 0; showShipmentItemForm = true; shipmentItemForm = new() { ShipmentId = shipmentId, OrderItemId = ShipmentOrderItems.FirstOrDefault()?.Id ?? 0, ProductPackagingId = packaging.FirstOrDefault()?.Id ?? 0, Quantity = 1 }; }
    private string NewOrderNumber() => $"ORD-{DateTime.Today:yyyyMMdd}-{orders.Count + 1:000}";
    private string NewShipmentNumber() => $"SHP-{DateTime.Today:yyyyMMdd}-{shipments.Count + 1:000}";
    private IEnumerable<OrderItem> ShipmentOrderItems => orderItems.Where(item => item.OrderId == shipmentItemOrderId);
    private void SyncShipmentOrderSelection() { if (!ShipmentOrderItems.Any()) shipmentItemForm.OrderItemId = 0; else if (!ShipmentOrderItems.Any(item => item.Id == shipmentItemForm.OrderItemId)) shipmentItemForm.OrderItemId = ShipmentOrderItems.First().Id; }
    private void ToggleProductDetails(int id) { expandedProductId = expandedProductId == id ? null : id; }
    private void TogglePackagingDetails(int id) { expandedPackagingId = expandedPackagingId == id ? null : id; }
    private void ToggleOrderItems(int id) { expandedOrderId = expandedOrderId == id ? null : id; CancelForms(); }
    private void ToggleShipmentItems(int id) { expandedShipmentId = expandedShipmentId == id ? null : id; CancelForms(); }
    private async Task ToggleOrderHistory(int id) { expandedOrderId = id; orderHistoryOrderId = orderHistoryOrderId == id ? null : id; if (orderHistoryOrderId == id) orderHistory = await Api.GetOrderHistoryAsync(id); }
    private async Task ToggleShipmentHistory(int id) { expandedShipmentId = id; shipmentHistoryShipmentId = shipmentHistoryShipmentId == id ? null : id; if (shipmentHistoryShipmentId == id) shipmentHistory = await Api.GetShipmentHistoryAsync(id); }
    private async Task ClearOrderHistoryAsync(int id) { await Api.ClearOrderHistoryAsync(id); orderHistory = []; }
    private async Task ClearShipmentHistoryAsync(int id) { await Api.ClearShipmentHistoryAsync(id); shipmentHistory = []; }
    private Task LoadCustomersAsync() => Reload(() => Api.GetCustomersAsync(), value => customers = value); private Task LoadProductsAsync() => Reload(() => Api.GetProductsAsync(), value => products = value); private Task LoadPackagingAsync() => Reload(() => Api.GetProductPackagingAsync(), value => packaging = value); private Task LoadPackagingTypesAsync() => Reload(() => Api.GetPackagingTypesAsync(), value => packagingTypes = value); private Task LoadPalletsAsync() => Reload(() => Api.GetPalletsAsync(), value => pallets = value); private Task LoadOrdersAsync() => Reload(() => Api.GetOrdersAsync(), value => orders = value); private Task LoadOrderItemsAsync() => Reload(() => Api.GetOrderItemsAsync(), value => orderItems = value); private Task LoadShipmentsAsync() => Reload(() => Api.GetShipmentsAsync(), value => shipments = value); private Task LoadShipmentItemsAsync() => Reload(() => Api.GetShipmentItemsAsync(), value => shipmentItems = value); private static async Task Reload<T>(Func<Task<List<T>>> load, Action<List<T>> assign) { assign(await load()); }
    private string CustomerName(int id) => customers.FirstOrDefault(x => x.Id == id)?.Name ?? $"Customer #{id}"; private string ProductName(int id) => products.FirstOrDefault(x => x.Id == id)?.Name ?? $"Product #{id}";
    private IEnumerable<Order> SortedOrders => Sort(orderSort, orderSortAscending, orders, order => order.ScheduledDate ?? DateTime.MinValue, order => CustomerName(order.CustomerId), order => (int)order.Status);
    private IEnumerable<Shipment> SortedShipments => Sort(shipmentSort, shipmentSortAscending, shipments, shipment => shipment.ScheduledDate ?? DateTime.MinValue, shipment => CustomerName(shipment.CustomerId), shipment => (int)shipment.Status);
