@inject LocalizationService L

<section class="history-panel">
    <div class="history-heading">
        <strong>@L["ChangeHistory"]</strong>
        <button class="danger-button" @onclick="OnClear">@L["ClearHistory"]</button>
    </div>
    @if (Entries.Count == 0)
    {
        <p class="history-empty">@L["NoChangesRecorded"]</p>
    }
    else
    {
        <div class="history-list">
            @foreach (var entry in Entries)
            {
                <div class="history-entry">
                    <div><strong>@L[entry.FieldName]</strong><small>@entry.ChangedAt.ToLocalTime().ToString("g")</small></div>
                    <span>@L[entry.OldValue]</span><span class="history-arrow">-&gt;</span><span>@L[entry.NewValue]</span>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ChangeHistory> Entries { get; set; } = [];
    [Parameter] public EventCallback OnClear { get; set; }
}
